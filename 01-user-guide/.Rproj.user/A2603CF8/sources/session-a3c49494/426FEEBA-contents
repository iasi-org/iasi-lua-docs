project:
  type: book
  resources:
    - resources/**

profile:
  default: html

metadata-files:
  - _book-structure.yml

book:
  title: "IASI Lua User Guide"
  subtitle: "Extensiones Lua reutilizables para Quarto"
  author: "IASI Project"

  navbar:
    title: "IASI"
    background: primary
    pinned: true
    left:
      - text: "Inicio"
        href: index.qmd
      - text: "IASI Lua"
        href: https://iasi-org.github.io/iasi-home/artifacts/iasi-lua.html
      - text: "Repository"
        href: https://github.com/iasi-org/iasi-lua

format:
  html:
    toc: true
    number-sections: true
    include-in-header:
      - resources/includes/ants.html

  pdf:
    documentclass: scrreprt
    toc: true
    number-sections: true

execute:
  freeze: auto
